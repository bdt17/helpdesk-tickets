<%= form_with model: article, class: "card p-4" do |f| %>
  <% if article.errors.any? %>
    <div class="alert alert-danger"><%= article.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true, maxlength: 150 %>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :category, class: "form-label" %>
      <%= f.select :category, Article::CATEGORIES, {}, class: "form-select" %>
    </div>
    <div class="col-md-6">
      <%= f.label :slug, "Web address (optional)", class: "form-label" %>
      <%= f.text_field :slug, class: "form-control", placeholder: "made from the title if blank", maxlength: 150 %>
    </div>
  </div>
  <div class="mb-3">
    <%= f.label :summary, "One-line summary (shown in search results)", class: "form-label" %>
    <%= f.text_field :summary, class: "form-control", maxlength: 300 %>
  </div>
  <div class="mb-3">
    <%= f.label :body, class: "form-label" %>
    <%= f.text_area :body, rows: 16, class: "form-control font-monospace", required: true %>
    <div class="form-text">Blank line = new paragraph. Start a line with "## " for a heading, "- " for a bullet point.</div>
  </div>
  <div class="form-check mb-3">
    <%= f.check_box :published, class: "form-check-input" %>
    <%= f.label :published, "Published (visible to everyone)", class: "form-check-label" %>
  </div>
  <div class="d-flex gap-2">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", article.persisted? ? article_path(article) : articles_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
