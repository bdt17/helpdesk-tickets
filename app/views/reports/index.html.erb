<% content_for :title, "Reports — Thomas IT Helpdesk" %>

<div class="container-fluid py-4">
  <h1 class="mb-4">Reports</h1>

  <% if @revenue %>
    <h5 class="mb-3">Revenue <small class="text-muted fw-normal">(admins only · estimated from listed prices; Stripe is the source of truth)</small></h5>
    <div class="row g-3 mb-3">
      <div class="col-md-3">
        <div class="card h-100 border-success border-2">
          <div class="card-body">
            <h6 class="card-title text-muted">Est. monthly revenue</h6>
            <h2 class="fw-bold mb-0 text-success"><%= number_to_currency(@revenue[:mrr], precision: 0) %></h2>
            <small class="text-muted">+ <%= number_to_currency(@revenue[:extra_ticket_revenue_30_days], precision: 0) %> extra tickets (30 days)</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <h6 class="card-title text-muted">Paying clients</h6>
          <h2 class="fw-bold mb-0"><%= @revenue[:active] %></h2>
          <small class="text-muted"><%= @revenue[:annual] %> annual · <%= @revenue[:trialing] %> trialing · <%= @revenue[:past_due] %> past due</small>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <h6 class="card-title text-muted">Client accounts</h6>
          <h2 class="fw-bold mb-0"><%= @revenue[:clients_total] %></h2>
          <small class="text-muted"><%= @revenue[:clients_new_30_days] %> new in 30 days · <%= @revenue[:clients_never_subscribed] %> never subscribed</small>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <h6 class="card-title text-muted">By plan</h6>
          <% Plan::ALL.each do |plan| %>
            <div class="d-flex justify-content-between small"><span><%= plan.name %></span><strong><%= @revenue[:by_plan].fetch(plan.key, 0) %></strong></div>
          <% end %>
        </div></div>
      </div>
    </div>

    <% if @revenue[:payment_problems].any? %>
      <div class="card border-danger mb-3">
        <div class="card-body">
          <h6 class="card-title text-danger">Payment problems - follow up</h6>
          <table class="table table-sm mb-0">
            <thead><tr><th>Organization</th><th>Owner</th><th>Plan</th><th>Status</th><th>Failed</th></tr></thead>
            <tbody>
              <% @revenue[:payment_problems].each do |org| %>
                <tr>
                  <td><%= org.name %></td>
                  <td><%= (owner = org.users.find { |u| u.org_role == "owner" }) ? mail_to(owner.email) : "-" %></td>
                  <td><%= org.plan_definition&.name || "-" %></td>
                  <td><%= org.subscription_status&.humanize || "-" %></td>
                  <td><%= org.payment_failed_at ? "#{time_ago_in_words(org.payment_failed_at)} ago" : "-" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <div class="card mb-4">
      <div class="card-body">
        <h6 class="card-title">System health</h6>
        <ul class="list-unstyled mb-0 small">
          <% @health.each do |label, ok| %>
            <li class="health-check" data-ok="<%= ok %>"><%= ok ? "✅" : "⚠️" %> <%= label %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="card mb-4" id="profitability">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
          <h6 class="card-title mb-0">Time &amp; revenue per client · <%= @profit_month.strftime("%B %Y") %></h6>
          <div class="small">
            <%= link_to "This month", reports_index_path(anchor: "profitability"), class: ("fw-bold" if params[:month] != "last") %> ·
            <%= link_to "Last month", reports_index_path(month: "last", anchor: "profitability"), class: ("fw-bold" if params[:month] == "last") %>
          </div>
        </div>
        <% if @profitability[:rows].empty? && @profitability[:total_minutes].zero? %>
          <p class="small text-muted mb-0">No paying clients or logged time yet. Technicians log time from each ticket's page.</p>
        <% else %>
          <div class="table-responsive">
            <table class="table table-sm small mb-1">
              <thead>
                <tr>
                  <th>Client</th><th>Plan</th><th class="text-end">Revenue/mo</th><th class="text-end">Time logged</th><th class="text-end">Revenue per hour</th>
                  <% if @profitability[:hourly_cost] %><th class="text-end">Est. profit</th><% end %>
                </tr>
              </thead>
              <tbody>
                <% @profitability[:rows].each do |row| %>
                  <tr class="profit-row">
                    <td><%= row[:organization].name %></td>
                    <td><%= row[:organization].subscribed? ? (row[:organization].plan_definition&.name || row[:organization].plan) : "No plan" %></td>
                    <td class="text-end"><%= number_to_currency(row[:revenue], precision: 0) %></td>
                    <td class="text-end"><%= row[:minutes].positive? ? TimeEntry.format_minutes(row[:minutes]) : "-" %></td>
                    <td class="text-end"><%= row[:per_hour] ? number_to_currency(row[:per_hour], precision: 0) : "-" %></td>
                    <% if @profitability[:hourly_cost] %>
                      <td class="text-end <%= "text-danger" if row[:profit].negative? %>"><%= number_to_currency(row[:profit], precision: 0) %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="small text-muted mb-0">
            <% if @profitability[:unaffiliated_minutes].positive? %>
              Plus <%= TimeEntry.format_minutes(@profitability[:unaffiliated_minutes]) %> on tickets from free or internal accounts.
            <% end %>
            Lowest revenue per hour first: those clients cost the most to support for what they pay.
            <% unless @profitability[:hourly_cost] %>Set STAFF_HOURLY_COST in Render to also see estimated profit.<% end %>
          </p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-white bg-primary h-100">
        <div class="card-body">
          <h6 class="card-title">Total Tickets</h6>
          <h2 class="fw-bold mb-0"><%= @total %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-danger h-100">
        <div class="card-body">
          <h6 class="card-title">Overdue</h6>
          <h2 class="fw-bold mb-0"><%= @overdue_count %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-success h-100">
        <div class="card-body">
          <h6 class="card-title">Resolved (30 days)</h6>
          <h2 class="fw-bold mb-0"><%= @resolved_last_30_days %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-secondary h-100">
        <div class="card-body">
          <h6 class="card-title">Open Now</h6>
          <h2 class="fw-bold mb-0"><%= @by_status["open"] || 0 %></h2>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="card-title text-muted">CSAT Average</h6>
          <h2 class="fw-bold mb-0">
            <%= @csat_average ? "#{@csat_average} / 5" : "—" %>
          </h2>
          <small class="text-muted"><%= @csat_responses %> response<%= "s" unless @csat_responses == 1 %></small>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white"><h5 class="mb-0">By Status</h5></div>
        <div class="card-body">
          <% Ticket.statuses.keys.each do |status| %>
            <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded">
              <span class="fw-semibold"><%= status.humanize %></span>
              <span class="badge <%= ticket_status_badge_class(status) %> px-3 py-2"><%= @by_status[status] || 0 %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white"><h5 class="mb-0">By Priority</h5></div>
        <div class="card-body">
          <% Ticket.priorities.keys.each do |priority| %>
            <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded">
              <span class="fw-semibold"><%= priority.humanize %></span>
              <span class="badge <%= ticket_priority_badge_class(priority) %> px-3 py-2"><%= @by_priority[priority] || 0 %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white"><h5 class="mb-0">By Category</h5></div>
        <div class="card-body">
          <% if @by_category.any? %>
            <% @by_category.each do |category, count| %>
              <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded">
                <span class="fw-semibold"><%= category&.humanize || "Uncategorized" %></span>
                <span class="badge bg-secondary px-3 py-2"><%= count %></span>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">No tickets yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mt-1">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white"><h5 class="mb-0">Agent Performance</h5></div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped mb-0">
              <thead>
                <tr>
                  <th>Agent</th>
                  <th>Open</th>
                  <th>Resolved</th>
                  <th>Avg. resolution time</th>
                </tr>
              </thead>
              <tbody>
                <% @agent_performance.each do |row| %>
                  <tr>
                    <td><%= row[:agent].email %></td>
                    <td><%= row[:open] %></td>
                    <td><%= row[:resolved] %></td>
                    <td><%= row[:avg_resolution_hours] ? "#{row[:avg_resolution_hours]} hrs" : "—" %></td>
                  </tr>
                <% end %>
                <% if @agent_performance.empty? %>
                  <tr><td colspan="4" class="text-muted text-center py-3">No agents yet.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
