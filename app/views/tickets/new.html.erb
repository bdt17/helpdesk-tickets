<div class="container py-4" style="max-width: 640px;">
  <h1 class="mb-4">New Ticket</h1>
  <div class="alert alert-light border small">
    <i class="fas fa-lightbulb brand me-1"></i>
    Quick question? The <%= link_to "Help Center", articles_path %> may have the answer right now.
  </div>
  <div class="card p-4">
    <%= render "form", ticket: @ticket %>
  </div>
</div>
