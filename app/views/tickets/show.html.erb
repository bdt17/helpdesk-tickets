<div class="p-6">
  <h1 class="mb-2"><%= @ticket.title %></h1>
  <p class="text-muted">
    Status: <%= @ticket.status&.humanize || "Open" %>
    &middot; Submitted by <%= @ticket.user&.email || "unknown" %>
    &middot; <%= time_ago_in_words(@ticket.created_at) %> ago
  </p>

  <% if policy(@ticket).update? %>
    <%= link_to "Edit", edit_ticket_path(@ticket), class: "btn btn-warning btn-sm" %>
  <% end %>
  <% if policy(@ticket).destroy? %>
    <%= button_to "Delete", ticket_path(@ticket), method: :delete, class: "btn btn-danger btn-sm",
                  data: { turbo_confirm: "Are you sure?" } %>
  <% end %>
  <%= link_to "Back to tickets", tickets_path, class: "btn btn-link btn-sm" %>
</div>
