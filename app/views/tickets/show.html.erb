<% content_for :title, "#{@ticket.title} — Thomas IT Helpdesk" %>

<div class="container py-4" style="max-width: 760px;">
  <%= link_to "← Back to tickets", tickets_path, class: "text-decoration-none small text-muted" %>

  <div class="card p-4 my-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
      <h1 class="h3 mb-0"><%= @ticket.title %></h1>
      <div class="d-flex gap-2">
        <span class="badge <%= ticket_status_badge_class(@ticket.status) %>"><%= @ticket.status.humanize %></span>
        <span class="badge <%= ticket_priority_badge_class(@ticket.priority) %>"><%= @ticket.priority.humanize %></span>
      </div>
    </div>

    <p class="text-muted small mb-3">
      <%= @ticket.category&.humanize || "Uncategorized" %>
      &middot; Submitted by <%= @ticket.user&.email || "unknown" %>
      &middot; Assigned to <%= @ticket.assignee&.email || "Unassigned" %>
      &middot; <%= time_ago_in_words(@ticket.created_at) %> ago
      <% if @ticket.resolved_at %>
        &middot; Resolved <%= time_ago_in_words(@ticket.resolved_at) %> ago
      <% end %>
    </p>

    <% if @ticket.description.present? %>
      <div class="mb-3"><%= simple_format(@ticket.description) %></div>
    <% end %>

    <div class="d-flex gap-2">
      <% if policy(@ticket).update? %>
        <%= link_to "Edit", edit_ticket_path(@ticket), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
      <% if policy(@ticket).destroy? %>
        <%= button_to "Delete", ticket_path(@ticket), method: :delete, class: "btn btn-outline-danger btn-sm",
                      data: { turbo_confirm: "Are you sure?" } %>
      <% end %>
    </div>
  </div>

  <% if policy(@ticket).rate? %>
    <div class="card p-3 mb-3 border-primary">
      <h2 class="h6 mb-2">How did we do?</h2>
      <%= form_with url: ticket_satisfaction_path(@ticket), method: :patch do |f| %>
        <div class="btn-group mb-2" role="group" aria-label="Satisfaction rating">
          <% (1..5).each do |n| %>
            <input type="radio" class="btn-check" name="ticket[satisfaction_rating]" id="rating_<%= n %>" value="<%= n %>" required>
            <label class="btn btn-outline-primary" for="rating_<%= n %>"><%= n %></label>
          <% end %>
        </div>
        <div class="form-group mb-2">
          <%= text_area_tag "ticket[satisfaction_comment]", nil, class: "form-control", rows: 2, placeholder: "Anything you'd like to add? (optional)" %>
        </div>
        <%= submit_tag "Submit feedback", class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  <% elsif @ticket.satisfaction_rating.present? %>
    <div class="card p-3 mb-3 bg-light">
      <span class="small text-muted">Your rating: <strong><%= @ticket.satisfaction_rating %>/5</strong></span>
      <% if @ticket.satisfaction_comment.present? %>
        <p class="mb-0 mt-1"><%= @ticket.satisfaction_comment %></p>
      <% end %>
    </div>
  <% end %>

  <h2 class="h5 mb-3">Comments</h2>
  <% @comments.each do |comment| %>
    <div class="card p-3 mb-2">
      <div class="small text-muted mb-1">
        <strong><%= comment.user.email %></strong>
        &middot; <%= time_ago_in_words(comment.created_at) %> ago
        <% if comment.internal? %>
          &middot; <span class="badge bg-warning text-dark">Internal</span>
        <% end %>
      </div>
      <div><%= simple_format(comment.body) %></div>
    </div>
  <% end %>
  <% if @comments.empty? %>
    <p class="text-muted">No comments yet.</p>
  <% end %>

  <div class="card p-3 mt-3">
    <%= form_with model: [ @ticket, @comment ] do |f| %>
      <div class="form-group mb-2">
        <%= f.label :body, "Add a comment", class: "form-label" %>
        <%= f.text_area :body, class: "form-control", rows: 3, required: true %>
      </div>

      <% if current_user.agent? || current_user.admin? %>
        <div class="form-check mb-2">
          <%= f.check_box :internal, class: "form-check-input" %>
          <%= f.label :internal, "Internal note (hidden from requester)", class: "form-check-label" %>
        </div>
      <% end %>

      <%= f.submit "Post comment", class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
</div>
