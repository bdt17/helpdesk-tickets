<%= form_with model: ticket do |f| %>
  <% if ticket.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% ticket.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :category, class: "form-label" %>
    <%= f.select :category, Ticket::CATEGORIES, { include_blank: true }, class: "form-select" %>
    <% if TicketCategorizer.configured? %>
      <div class="form-text">Leave blank and we'll suggest one automatically.</div>
    <% end %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :attachments, "Add attachments", class: "form-label" %>
    <%= f.file_field :attachments, multiple: true, class: "form-control" %>
    <div class="form-text">
      Images, PDF, or plain text — up to <%= Ticket::MAX_ATTACHMENTS %> files,
      <%= Ticket::MAX_ATTACHMENT_SIZE / 1.megabyte %>MB each.
      <% if ticket.persisted? %>New files are added to what's already attached.<% end %>
    </div>
  </div>

  <% persisted_attachments = ticket.persisted? ? ticket.attachments.select(&:persisted?) : [] %>
  <% if persisted_attachments.any? %>
    <div class="form-group mb-3">
      <span class="form-label d-block">Already attached</span>
      <ul class="list-unstyled small mb-0">
        <% persisted_attachments.each do |attachment| %>
          <li><%= link_to attachment.filename.to_s, ticket_attachment_path(ticket, attachment) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if policy(ticket).update? && (current_user.agent? || current_user.admin?) %>
    <div class="form-group mb-3">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status, Ticket.statuses.keys, {}, class: "form-select" %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :priority, class: "form-label" %>
      <%= f.select :priority, Ticket.priorities.keys, {}, class: "form-select" %>
      <% if ticket.user&.client? %>
        <div class="form-text">
          <%= ticket.user.plan_definition&.name || "This client's" %> plan allows up to
          <strong><%= ticket.user.max_ticket_priority %></strong> priority.
        </div>
      <% end %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :assignee_id, "Assigned agent", class: "form-label" %>
      <%= f.collection_select :assignee_id, User.where(role: [:agent, :admin]).order(:email), :id, :email, { include_blank: "Unassigned" }, class: "form-select" %>
    </div>
  <% end %>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
