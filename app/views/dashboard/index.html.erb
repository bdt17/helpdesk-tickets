<div class="container-fluid p-4">
  <h1 class="mb-4"><%= current_user.agent? || current_user.admin? ? "Team Dashboard" : "My Dashboard" %></h1>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-white bg-primary h-100">
        <div class="card-body">
          <h6 class="card-title">Total Tickets</h6>
          <h2 class="fw-bold mb-0"><%= @total %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-warning h-100">
        <div class="card-body">
          <h6 class="card-title">Open</h6>
          <h2 class="fw-bold mb-0"><%= @by_status["open"] || 0 %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-danger h-100">
        <div class="card-body">
          <h6 class="card-title">Overdue</h6>
          <h2 class="fw-bold mb-0"><%= @overdue.size %></h2>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-success h-100">
        <div class="card-body">
          <h6 class="card-title">Resolved</h6>
          <h2 class="fw-bold mb-0"><%= @by_status["resolved"] || 0 %></h2>
        </div>
      </div>
    </div>
  </div>

  <% if @unassigned_count %>
    <p class="text-muted">
      <strong><%= @unassigned_count %></strong> unassigned open ticket<%= "s" unless @unassigned_count == 1 %>.
    </p>
  <% end %>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white">
          <h5 class="mb-0">Overdue Tickets</h5>
        </div>
        <div class="card-body p-0">
          <% if @overdue.any? %>
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr><th>Title</th><th>Priority</th><th>Assignee</th><th>Due</th></tr>
              </thead>
              <tbody>
                <% @overdue.each do |ticket| %>
                  <tr>
                    <td><%= link_to ticket.title, ticket_path(ticket) %></td>
                    <td><span class="badge <%= ticket_priority_badge_class(ticket.priority) %>"><%= ticket.priority.humanize %></span></td>
                    <td><%= ticket.assignee&.email || "Unassigned" %></td>
                    <td><%= time_ago_in_words(ticket.due_at) %> ago</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted p-3 mb-0">Nothing overdue right now.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white">
          <h5 class="mb-0">By Priority</h5>
        </div>
        <div class="card-body">
          <% Ticket.priorities.keys.each do |priority| %>
            <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-light rounded">
              <span class="fw-semibold"><%= priority.humanize %></span>
              <span class="badge bg-primary px-3 py-2"><%= @by_priority[priority] || 0 %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-header bg-white">
      <h5 class="mb-0">Recent Tickets</h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr><th>Title</th><th>Status</th><th>Created</th></tr>
        </thead>
        <tbody>
          <% @recent.each do |ticket| %>
            <tr>
              <td><%= link_to ticket.title, ticket_path(ticket) %></td>
              <td><span class="badge <%= ticket_status_badge_class(ticket.status) %>"><%= ticket.status.humanize %></span></td>
              <td class="text-muted small"><%= time_ago_in_words(ticket.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
