<% content_for :title, "Backup codes — Thomas IT Helpdesk" %>
<div class="container py-4" style="max-width: 640px;">
  <h1 class="mb-3">Save your backup codes</h1>
  <div class="alert alert-warning">
    <strong>This is the only time you'll see these.</strong> If you lose your phone, each code gets you in once.
    Keep them in a password manager or print them. Don't email them to yourself.
  </div>
  <div class="card p-4 mb-3">
    <div class="row row-cols-2 g-2 font-monospace fs-5 text-center">
      <% @backup_codes.each do |code| %>
        <div class="col"><%= code %></div>
      <% end %>
    </div>
  </div>
  <%= link_to "I've saved them - continue", dashboard_path, class: "btn btn-primary" %>
</div>
