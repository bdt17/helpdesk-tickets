<% content_for :title, "IT Support Services#{ServicePage.area_suffix} | Thomas Information Technology" %>
<% content_for :description, "Managed IT help desk, network, computer, software and account support for small businesses#{ServicePage.area_suffix}. Plans with response times you can hold us to." %>

<div class="container py-5">
  <h1 class="fw-bold mb-2">IT support services<%= ServicePage.area_suffix %></h1>
  <p class="lead text-muted mb-4">
    Everything a small business would otherwise need an in-house IT person for, handled through one help desk.
  </p>

  <div class="row g-4">
    <% ServicePage::ALL.each do |service| %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 p-4">
          <i class="fas <%= service.icon %> fa-2x brand mb-3"></i>
          <h2 class="h5"><%= link_to service.name, service_path(service.slug), class: "stretched-link text-decoration-none text-dark" %></h2>
          <p class="text-muted small mb-0"><%= service.summary %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-5">
    <%= link_to "See plans and pricing", root_path(anchor: "plans"), class: "btn btn-primary btn-lg px-4 me-2" %>
    <%= link_to "Talk to us", root_path(anchor: "contact"), class: "btn btn-outline-primary btn-lg px-4" %>
  </div>
</div>
