<div class="login-container">
  <div class="login-form card p-4 shadow-lg">
    <div class="text-center mb-4">
      <i class="fas fa-headset fa-3x brand mb-3"></i>
      <h2 class="brand mb-1">Thomas IT Helpdesk</h2>
      <p class="text-muted mb-0">Sign In</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, html: { class: "text-center" }) do |f| %>
      <div class="form-group mb-4">
        <%= f.label :email, "Email", class: "form-label fw-bold text-center d-block" %>
        <%= f.email_field :email, class: "form-control form-control-lg text-center mt-2",
                          placeholder: "you@thomasit.com", required: true, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :password, "Password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password, class: "form-control form-control-lg text-center mt-2",
                             placeholder: "••••••••", required: true, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group mb-4">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>

      <%= f.submit "Log In", class: "btn btn-primary btn-lg w-100 py-3 fw-bold" %>
    <% end %>

    <div class="mt-3 text-center">
      <%= link_to "Forgot your password?", new_password_path(resource_name) %>
    </div>
  </div>
</div>
