<div class="login-container">
  <div class="login-form card p-4 shadow-lg">
    <div class="text-center mb-4">
      <i class="fas fa-user-gear fa-3x brand mb-3"></i>
      <h2 class="brand mb-1">Account Settings</h2>
      <p class="text-muted mb-0">Signed in as <%= resource.email %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                  html: { method: :patch, class: "text-center" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="alert alert-danger text-start">
          <ul class="mb-0">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group mb-4">
        <%= f.label :email, "Email", class: "form-label fw-bold text-center d-block" %>
        <%= f.email_field :email, class: "form-control form-control-lg text-center mt-2", autocomplete: "email" %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :password, "New Password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password, class: "form-control form-control-lg text-center mt-2",
                             placeholder: "Leave blank to keep your current password", autocomplete: "new-password" %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :password_confirmation, "Confirm New Password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password_confirmation, class: "form-control form-control-lg text-center mt-2", autocomplete: "new-password" %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :current_password, "Current Password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :current_password, class: "form-control form-control-lg text-center mt-2",
                             placeholder: "Required to save any change", required: true, autocomplete: "current-password" %>
      </div>

      <%= f.submit "Save Changes", class: "btn btn-primary btn-lg w-100 py-3 fw-bold" %>
    <% end %>

    <div class="mt-3 text-center">
      <%= link_to "← Back", dashboard_path %>
    </div>
  </div>
</div>
