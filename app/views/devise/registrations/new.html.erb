<div class="login-container">
  <div class="login-form card p-4 shadow-lg">
    <div class="text-center mb-4">
      <i class="fas fa-user-plus fa-3x brand mb-3"></i>
      <h2 class="brand mb-1">Create Your Account</h2>
      <p class="text-muted mb-0">Sign up to start opening support tickets</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "text-center" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="alert alert-danger text-start">
          <ul class="mb-0">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group mb-4">
        <%= f.label :email, "Email", class: "form-label fw-bold text-center d-block" %>
        <%= f.email_field :email, class: "form-control form-control-lg text-center mt-2",
                          placeholder: "you@yourcompany.com", required: true, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :password, "Password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password, class: "form-control form-control-lg text-center mt-2",
                             placeholder: "••••••••", required: true, autocomplete: "new-password" %>
        <% if @minimum_password_length %>
          <small class="text-muted"><%= @minimum_password_length %> characters minimum</small>
        <% end %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password_confirmation, class: "form-control form-control-lg text-center mt-2",
                             placeholder: "••••••••", required: true, autocomplete: "new-password" %>
      </div>

      <%= f.submit "Sign Up", class: "btn btn-primary btn-lg w-100 py-3 fw-bold" %>
    <% end %>

    <div class="mt-3 text-center">
      <%= link_to "Already have an account? Log in", new_user_session_path %>
    </div>
  </div>
</div>
