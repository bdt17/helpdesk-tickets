<div class="login-container">
  <div class="login-form card p-4 shadow-lg">
    <h2 class="pharma-blue mb-4 text-center">Forgot your password?</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "text-center" }) do |f| %>
      <div class="form-group mb-4">
        <%= f.label :email, "Email", class: "form-label fw-bold text-center d-block" %>
        <%= f.email_field :email, class: "form-control form-control-lg text-center mt-2",
                          required: true, autofocus: true, autocomplete: "email" %>
      </div>

      <%= f.submit "Send reset instructions", class: "btn btn-primary btn-lg w-100 py-3 fw-bold" %>
    <% end %>

    <div class="mt-3 text-center">
      <%= link_to "Back to sign in", new_session_path(resource_name) %>
    </div>
  </div>
</div>
