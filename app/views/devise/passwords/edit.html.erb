<div class="login-container">
  <div class="login-form card p-4 shadow-lg">
    <h2 class="pharma-blue mb-4 text-center">Update your password</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "text-center" }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <div class="form-group mb-4">
        <%= f.label :password, "New password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password, class: "form-control form-control-lg text-center mt-2",
                             required: true, autofocus: true, autocomplete: "new-password" %>
      </div>

      <div class="form-group mb-4">
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label fw-bold text-center d-block" %>
        <%= f.password_field :password_confirmation, class: "form-control form-control-lg text-center mt-2",
                             required: true, autocomplete: "new-password" %>
      </div>

      <%= f.submit "Save new password", class: "btn btn-primary btn-lg w-100 py-3 fw-bold" %>
    <% end %>
  </div>
</div>
