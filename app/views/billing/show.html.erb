<% content_for :title, "Billing — Thomas IT Helpdesk" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Billing</h1>
    <% if current_user.org_owner? %>
      <%= link_to "Manage Team", team_path, class: "btn btn-outline-secondary btn-sm" %>
    <% end %>
  </div>

  <% if @organization && !current_user.org_owner? %>
    <div class="alert alert-info">
      You're on <strong><%= @organization.owner&.email || "your organization" %>'s</strong> plan as a team member.
      Only the account owner can change plans or payment details.
    </div>
  <% end %>

  <% if current_user.subscribed? %>
    <div class="card p-4 mb-4">
      <h4 class="brand mb-1">
        Current plan: <%= current_user.plan_definition&.name || @organization.plan&.humanize %>
      </h4>
      <p class="text-muted mb-3">Status: <%= @organization.subscription_status.humanize %></p>
      <% if current_user.org_owner? %>
        <%= button_to "Manage Billing", billing_portal_path, method: :post,
                       class: "btn btn-primary", form: { class: "d-inline" } %>
      <% end %>
    </div>
  <% elsif @organization&.stripe_customer_id.present? && current_user.org_owner? %>
    <div class="alert alert-warning">
      No active subscription — pick a plan below to get started, or
      <%= button_to "manage billing", billing_portal_path, method: :post,
                     class: "btn btn-link p-0 align-baseline", form: { class: "d-inline" } %> if you have a past subscription.
    </div>
  <% end %>

  <% if Plan.extra_tickets_enabled? && current_user.monthly_ticket_limit && (current_user.org_owner? || @organization.nil?) %>
    <div class="card p-4 mb-4 <%= "border-warning border-2" if current_user.ticket_limit_reached? %>">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <h5 class="mb-1">Need more tickets this month?</h5>
          <p class="text-muted small mb-0">
            Extra tickets are <%= number_to_currency(Plan.extra_ticket_price_cents / 100.0) %> each, no plan change needed.
            You've used <%= current_user.tickets_filed_this_month %> of <%= current_user.monthly_ticket_limit %> this month<% if current_user.extra_ticket_credits.positive? %>, with <strong><%= current_user.extra_ticket_credits %> extra</strong> still available<% end %>.
          </p>
        </div>
        <%= form_with url: billing_extra_tickets_path, method: :post, class: "d-flex gap-2 align-items-center" do %>
          <%= select_tag :quantity, options_for_select((1..Plan::MAX_EXTRA_TICKETS_PER_PURCHASE).to_a, 1),
                         class: "form-select form-select-sm", style: "width: auto;", "aria-label": "Number of extra tickets" %>
          <%= submit_tag "Buy extra tickets", class: "btn btn-warning btn-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if current_user.org_owner? || @organization.nil? %>
    <div class="row g-4">
      <% @plans.each do |plan| %>
        <div class="col-md-4">
          <div class="card h-100 p-4 d-flex flex-column">
            <h4 class="brand"><%= plan.name %></h4>
            <p class="text-muted small mb-1"><%= plan.display_price %></p>
            <p class="text-muted small"><%= plan.tagline %></p>
            <ul class="small mb-3">
              <li>Up to <%= plan.max_seats %> seats</li>
              <li><%= Plan.ticket_allowance_label(plan.monthly_ticket_limit) %></li>
              <% plan.features.each do |feature| %>
                <li><%= feature %></li>
              <% end %>
            </ul>
            <% if @organization&.plan == plan.key && current_user.subscribed? %>
              <span class="badge bg-success align-self-start mt-auto">
                Current Plan<%= " (annual)" if @organization.annual? %>
              </span>
            <% else %>
              <div class="mt-auto d-grid gap-2">
                <%= button_to "Subscribe monthly", billing_checkout_path(plan: plan.key), method: :post,
                               class: "btn btn-primary w-100" %>
                <% if Plan.annual_price_id_for(plan.key) %>
                  <%= button_to billing_checkout_path(plan: plan.key, interval: "year"), method: :post,
                                 class: "btn btn-outline-primary w-100" do %>
                    Pay yearly - <%= number_to_currency(Plan.annual_dollars(plan), precision: 0) %>/yr
                    <span class="d-block small">2 months free</span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
