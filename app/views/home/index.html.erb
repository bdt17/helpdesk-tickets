<% content_for :title, "Thomas Information Technology — Managed IT Help Desk" %>

<main class="landing-page">
  <section class="hero text-center py-5 px-3">
    <h1 class="display-5 fw-bold mb-3">Thomas Information Technology</h1>
    <p class="lead mb-4">
      A fully staffed IT help desk for your business — ticket tracking, real technicians,
      and response times you can hold us to. No in-house IT team required.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <% if user_signed_in? %>
        <%= link_to "Go to Dashboard", dashboard_path, class: "btn btn-primary btn-lg px-4" %>
      <% else %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary btn-lg px-4" %>
        <%= link_to "Log In", new_user_session_path, class: "btn btn-outline-light btn-lg px-4" %>
      <% end %>
      <a href="#contact" class="btn btn-outline-light btn-lg px-4">Talk to Us First</a>
    </div>
  </section>

  <section class="py-5 px-3">
    <div class="container">
      <h2 class="text-center fw-bold mb-4">What we cover</h2>
      <div class="row g-4">
        <div class="col-md-3 col-6">
          <div class="card h-100 p-3 text-center">
            <i class="fas fa-desktop fa-2x brand mb-2"></i>
            <h5>Hardware</h5>
            <p class="text-muted small mb-0">Workstations, peripherals, on-site repairs</p>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="card h-100 p-3 text-center">
            <i class="fas fa-laptop-code fa-2x brand mb-2"></i>
            <h5>Software</h5>
            <p class="text-muted small mb-0">Installs, licensing, day-to-day troubleshooting</p>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="card h-100 p-3 text-center">
            <i class="fas fa-network-wired fa-2x brand mb-2"></i>
            <h5>Network</h5>
            <p class="text-muted small mb-0">Connectivity, Wi-Fi, VPN, outages</p>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="card h-100 p-3 text-center">
            <i class="fas fa-user-shield fa-2x brand mb-2"></i>
            <h5>Access</h5>
            <p class="text-muted small mb-0">Accounts, permissions, password resets</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 px-3" id="plans">
    <div class="container">
      <h2 class="text-center fw-bold mb-2">Support Plans</h2>
      <p class="text-center text-muted mb-4">
        Every plan is backed by the same response-time commitment we hold our own team to.
      </p>
      <div class="row g-4 justify-content-center">
        <% Plan::ALL.each do |plan| %>
          <div class="col-md-4">
            <div class="card h-100 p-4 d-flex flex-column <%= "border-primary border-2" if plan.key == "business" %>">
              <h4 class="brand"><%= plan.name %></h4>
              <p class="text-muted small mb-1"><%= plan.display_price %></p>
              <p class="text-muted small"><%= plan.tagline %></p>
              <ul class="small mb-3">
                <li>Up to <%= plan.max_seats %> seats</li>
                <li><%= Plan.ticket_allowance_label(plan.monthly_ticket_limit) %></li>
                <% plan.features.each do |feature| %>
                  <li><%= feature %></li>
                <% end %>
              </ul>
              <%= link_to "Get Started", new_user_registration_path,
                           class: "btn #{plan.key == 'business' ? 'btn-primary' : 'btn-outline-primary'} mt-auto" %>
            </div>
          </div>
        <% end %>
      </div>
      <% if Plan.annual_billing_available? %>
        <p class="text-center fw-semibold mt-4 mb-0">Pay yearly and get 2 months free.</p>
      <% end %>
      <p class="text-center text-muted small mt-4">
        Pricing quoted per client based on team size — reach out and we'll put together a quote.
      </p>
    </div>
  </section>

  <section class="cta text-center py-5 px-3">
    <h2 class="fw-bold mb-3">Ready to stop firefighting IT issues yourself?</h2>
    <% if Plan.free_tickets_per_month.positive? %>
      <p class="text-muted mb-4">
        Try us first: create a free account and your first
        <%= Plan.free_tickets_per_month == 1 ? "ticket" : "#{Plan.free_tickets_per_month} tickets" %>
        each month <%= Plan.free_tickets_per_month == 1 ? "is" : "are" %> on us - no card required.
      </p>
    <% end %>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary btn-lg px-4" %>
      <a href="#contact" class="btn btn-outline-primary btn-lg px-4">Contact Sales</a>
    </div>
  </section>

  <section class="py-5 px-3" id="contact">
    <div class="container" style="max-width: 640px;">
      <h2 class="text-center fw-bold mb-2">Talk to us</h2>
      <p class="text-center text-muted mb-4">
        Tell us a bit about your team and what's breaking. We'll get back to you with a plan and a quote.
      </p>
      <%= form_with model: Lead.new, url: leads_path, class: "card p-4" do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :name, "Your name", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", required: true, maxlength: 100, autocomplete: "name" %>
          </div>
          <div class="col-md-6">
            <%= f.label :email, "Work email", class: "form-label" %>
            <%= f.email_field :email, class: "form-control", required: true, maxlength: 255, autocomplete: "email" %>
          </div>
          <div class="col-md-6">
            <%= f.label :company, class: "form-label" %>
            <%= f.text_field :company, class: "form-control", maxlength: 100, autocomplete: "organization" %>
          </div>
          <div class="col-md-6">
            <%= f.label :phone, "Phone (optional)", class: "form-label" %>
            <%= f.telephone_field :phone, class: "form-control", maxlength: 100, autocomplete: "tel" %>
          </div>
          <div class="col-12">
            <%= f.label :message, "How can we help?", class: "form-label" %>
            <%= f.text_area :message, rows: 4, class: "form-control", maxlength: 5000 %>
          </div>
          <%# Honeypot - hidden from people, filled in by bots (see LeadsController#create). %>
          <div class="d-none" aria-hidden="true">
            <%= label_tag :website, "Website" %>
            <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
          </div>
          <div class="col-12">
            <%= f.submit "Send message", class: "btn btn-primary w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</main>
