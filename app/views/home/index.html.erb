<h1>Thomas IT Helpdesk</h1>

<% if user_signed_in? %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 400px;">
    <%= link_to "Dashboard", dashboard_path, class: "bg-green-500 text-white px-6 py-3 rounded text-center block text-decoration-none" %>
    <%= link_to "Tickets", tickets_path, class: "bg-blue-500 text-white px-6 py-3 rounded text-center block text-decoration-none" %>
  </div>
<% else %>
  <p><%= link_to "Log in", new_user_session_path %> to view your tickets.</p>
<% end %>
