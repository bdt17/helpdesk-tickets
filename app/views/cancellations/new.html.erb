<% content_for :title, "Cancel plan — Thomas IT Helpdesk" %>

<div class="container py-4" style="max-width: 680px;">
  <h1 class="mb-2">Cancel your plan</h1>
  <p class="text-muted mb-4">
    Sorry to see you go. Your plan stays active until the end of the period you've paid for,
    and you can change your mind any time before then.
  </p>

  <% if @organization.retention_offer_available? %>
    <div class="card p-4 mb-4 border-primary border-2">
      <h2 class="h5 brand mb-2">Before you go: <%= Plan::RETENTION_OFFER %></h2>
      <p class="text-muted mb-3">Stay on your current plan and we'll take <%= Plan::RETENTION_OFFER %>. No other changes.</p>
      <%= button_to "Stay and take the discount", billing_retention_offer_path, method: :post, class: "btn btn-primary", form: { class: "d-inline" } %>
    </div>
  <% end %>

  <% if @organization.plan.present? && @organization.plan != Plan::ALL.first.key %>
    <div class="card p-4 mb-4">
      <h2 class="h5 mb-2">Need less? Switch to a smaller plan</h2>
      <p class="text-muted mb-3">Keep support for less by moving to a cheaper plan instead.</p>
      <%= button_to "Change plan", billing_portal_path, method: :post, class: "btn btn-outline-primary", form: { class: "d-inline" } %>
    </div>
  <% end %>

  <%= form_with url: billing_cancel_path, method: :post, class: "card p-4" do %>
    <h2 class="h5 mb-3">Why are you canceling?</h2>
    <% Organization::CANCELLATION_REASONS.each do |key, label| %>
      <div class="form-check mb-2">
        <%= radio_button_tag :reason, key, false, class: "form-check-input", required: true %>
        <%= label_tag "reason_#{key}", label, class: "form-check-label" %>
      </div>
    <% end %>
    <div class="mt-3">
      <%= label_tag :comment, "Anything we could have done better? (optional)", class: "form-label" %>
      <%= text_area_tag :comment, nil, rows: 3, maxlength: 2000, class: "form-control" %>
    </div>
    <div class="d-flex gap-2 mt-4 flex-wrap">
      <%= submit_tag "Cancel my plan", class: "btn btn-danger" %>
      <%= link_to "Never mind, keep my plan", billing_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
