tmp/cache/*
tmp/pids/*
tmp/sessions/*
log/*.log

# Ignore SQLite databases
storage/*.sqlite3
storage/*.sqlite3-shm
storage/*.sqlite3-wal
storage/*.sqlite3_[0-9]*

# Backups, dumps, and cookie jars — never commit these
/backup-*.sql
/backup-*.sqlite3
*.tar.gz
cookies.txt

# Stray editor/manual backup files
*.bak
*.bak[0-9]
*.backup
*.broken
