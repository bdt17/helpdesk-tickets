# Copy to .env for local development (never commit the real .env file).
# In production (Render), set these as real environment variables instead —
# dotenv-rails only loads .env in development/test.

# Stripe API keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret for the /webhooks/stripe endpoint, from the webhook's
# settings page in the Stripe dashboard (or `stripe listen` output locally).
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for the three support plans — created by `bin/rails stripe:setup_plans`,
# which prints these lines for you to paste in here.
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_PRIORITY=price_...

# Outgoing email (production). Any SMTP provider works - Postmark,
# SendGrid, Resend, Mailgun, AWS SES. Without SMTP_ADDRESS no mail is sent
# at all (password resets, team invites, ticket notifications).
SMTP_ADDRESS=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=...
SMTP_PASSWORD=...
# Sender address - must be on a domain your SMTP provider has verified.
MAIL_FROM=support@thomasinformationtechnology.com
# Host used for links inside emails.
APP_HOST=thomasinformationtechnology.com

# Persistent-disk path for ticket attachments in production (Render disk
# mounted at /var/data). Unset = files are lost on every deploy.
ACTIVE_STORAGE_ROOT=/var/data/storage
